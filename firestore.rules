rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read and write only their own user documents
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Allow users to read and write only their own order documents
      match /orders/{orderId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Allow secure commission submissions (client can create, but cannot read/edit/delete)
    match /commissions/{commissionId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Allow anyone to read sold paintings status, and authenticated users to create them
    match /sold_paintings/{paintingId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Allow authenticated users to create their own order copy under root-level all_orders
    // Allow sankalprajsts2122@gmail.com full read/write access to manage shipments
    match /all_orders/{orderId} {
      allow read: if request.auth != null && (request.auth.token.email == 'sankalprajsts2122@gmail.com' || resource.data.uid == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && (request.auth.token.email == 'sankalprajsts2122@gmail.com' || resource.data.uid == request.auth.uid);
      allow delete: if request.auth != null && request.auth.token.email == 'sankalprajsts2122@gmail.com';
    }
  }
}
